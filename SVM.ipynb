#Support Vector Machine (SVM)
from sklearn.datasets import load_iris
from sklearn.model_selection import train_test_split
from sklearn.svm import SVC
from sklearn.metrics import accuracy_score
import numpy as np
import matplotlib.pyplot as plt

# Load data
iris = load_iris()
X, y = iris.data, iris.target
X1, y1 = X[y != 2], y[y != 2]

# TC1: Linearly separable data
m1 = SVC(kernel='linear').fit(X1, y1)
print("TC1 Accuracy:", accuracy_score(y1, m1.predict(X1)))

# TC2: Train-test split
Xt, Xv, yt, yv = train_test_split(X1, y1, test_size=0.2, random_state=42)
m2 = SVC(kernel='linear').fit(Xt, yt)
print("TC2 Accuracy:", accuracy_score(yv, m2.predict(Xv)))

# TC3: Support vector
m3 = SVC(kernel='linear').fit(X1, y1)
point = m3.support_vectors_[0].reshape(1, -1)
print("TC3 Predicted Class:", m3.predict(point)[0])
print("TC3 Decision Value:", m3.decision_function(point)[0])

# TC4: Overlapping classes
X4 = X1 + np.random.normal(0, 0.8, X1.shape)
m4 = SVC(kernel='linear').fit(X4, y1)
print("TC4 Accuracy:", accuracy_score(y1, m4.predict(X4)))

# TC5: Single-class data
try:
    SVC(kernel='linear').fit(X[y == 0], y[y == 0])
except ValueError:
    print("TC5: SVM needs at least two classes")

# Graph
Xg = X1[:, [0, 1]]
mg = SVC(kernel='linear').fit(Xg, y1)

plt.scatter(Xg[y1 == 0, 0], Xg[y1 == 0, 1], label="Class 0")
plt.scatter(Xg[y1 == 1, 0], Xg[y1 == 1, 1], label="Class 1")

xx = np.linspace(Xg[:, 0].min(), Xg[:, 0].max(), 100)
w, b = mg.coef_[0], mg.intercept_[0]

plt.plot(xx, -(w[0]*xx+b)/w[1], label="Hyperplane")
plt.plot(xx, -(w[0]*xx+b-1)/w[1], '--', label="Margin +1")
plt.plot(xx, -(w[0]*xx+b+1)/w[1], '--', label="Margin -1")

plt.scatter(mg.support_vectors_[:, 0], mg.support_vectors_[:, 1],
            facecolors='none', edgecolors='black', s=100,
            label="Support Vectors")

plt.xlabel("Sepal Length")
plt.ylabel("Sepal Width")
plt.title("SVM Classification")
plt.legend()
plt.grid()
plt.show()
