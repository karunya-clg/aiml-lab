#BFS DFS
from collections import deque

# ---------------- BFS Function ----------------
def bfs(graph, start):
    visited = set()
    queue = deque([start])

    while queue:
        node = queue.popleft()

        if node not in visited:
            print(node, end=" ")
            visited.add(node)

            for neighbor in graph[node]:
                if neighbor not in visited:
                    queue.append(neighbor)

# ---------------- DFS Function ----------------
visited = set()

def dfs(graph, node):
    if node not in visited:
        print(node, end=" ")
        visited.add(node)

        for neighbor in graph[node]:
            dfs(graph, neighbor)

# ---------------- Test Case 1: Connected Graph ----------------
graph1 = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': [],
    'E': [],
    'F': []
}

print("Test Case 1: Connected Graph")
print("BFS:", end=" ")
bfs(graph1, 'A')
print()

print("DFS:", end=" ")
visited.clear()
dfs(graph1, 'A')
print("\n")

# ---------------- Test Case 2: Multiple Branches ----------------
graph2 = {
    'A': ['B', 'C', 'D'],
    'B': ['E'],
    'C': ['F'],
    'D': [],
    'E': [],
    'F': []
}

print("Test Case 2: Multiple Branches")
print("BFS:", end=" ")
bfs(graph2, 'A')
print()

print("DFS:", end=" ")
visited.clear()
dfs(graph2, 'A')
print("\n")

# ---------------- Test Case 3: Cyclic Graph ----------------
graph3 = {
    'A': ['B', 'C'],
    'B': ['D'],
    'C': ['A'],
    'D': ['E'],
    'E': ['F'],
    'F': ['B']
}

print("Test Case 3: Cyclic Graph")
print("BFS:", end=" ")
bfs(graph3, 'A')
print()

print("DFS:", end=" ")
visited.clear()
dfs(graph3, 'A')
print("\n")
